# Environment Variables for SQ Agriculture Web
# Copy this to .env.local for local development

# API URL (NestJS backend)
NEXT_PUBLIC_API_URL="http://localhost:3001"

# App URL (Vercel URL after deploy, or localhost for dev)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"

# Google Analytics 4 (leave empty for development)
NEXT_PUBLIC_GA_ID=""

# Sentry Error Tracking (leave empty for development)
NEXT_PUBLIC_SENTRY_DSN=""